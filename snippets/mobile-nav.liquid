{{ 'mobile-nav.css' | asset_url | stylesheet_tag }}

<div id="MobileNavOverlay" class="de-overlay" aria-hidden="true"></div>

<aside
  id="MobileNav"
  class="de-mobile-nav"
  aria-hidden="true"
  aria-label="Mobile navigation"
  role="dialog"
  aria-modal="true"
>
  <div class="de-mobile-nav__head">
    <span class="de-mobile-nav__title">Menu</span>
    <button type="button" class="de-mobile-nav__close" data-drawer-close aria-label="Close menu">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="de-mobile-nav__nav" aria-label="Mobile menu">
    <ul class="de-mobile-nav__list">
      {%- for link in linklists.main-menu.links -%}
        <li>
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <div class="de-mobile-nav__foot">
    <a href="{{ routes.account_url }}" class="de-mobile-nav__account-link">
      {{ 'customer.account.title' | t | default: 'Account' }}
    </a>
  </div>
</aside>
