{{ 'home-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-home-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'can-gl.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'section-home-shop.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Pulled from the Variant F mock's PDP/shop section (#shop / #mshop). The
  spinning turntable canvases (pdpCv/mpdpCv) render the mock's WebGL
  cylinder-unwrap "spin" effect (ported in can-gl.js) when WebGL is
  available; the static c-cherry/c-pine images are the flat-flip fallback
  used when it's not. Pricing, copy and purchase options are still
  hard-coded and need
  to be wired to real products/variants in a follow-up pass.
{%- endcomment -%}

<div class="de-home-section__desktop">
  <div class="de-comp">
    <div class="de-comp__inner shop-comp">
  <section class="sec shop-d-1" id="shop"  aria-label="Shop">
    <div class="pdp fx-rise shop-d-2" data-fx="cards" id="pdp" data-flavor="cherry"
      data-spin-cherry="{{ 'spin_cl.webp' | asset_url }}" data-spin-pine="{{ 'spin_pm.webp' | asset_url }}" >
      <img class="shop-d-3" src="{{ 'pdp_bg_clean.webp' | asset_url }}" alt="" loading="lazy" >
      <div class="wash"></div>
      <div class="fset cherry">
        <div class="fruit back shop-d-4" data-px="-0.05" ><div class="fb"><img src="{{ 'pdp_lime.webp' | asset_url }}" alt="" loading="lazy"></div></div>
        <div class="fruit back shop-d-5" data-px="-0.07" ><div class="fb"><img src="{{ 'pdp_cherry.webp' | asset_url }}" alt="" loading="lazy"></div></div>
      </div>
      <div class="fset pine">
        <div class="fruit back shop-d-6" data-px="-0.05" ><div class="fb"><img class="shop-d-7" src="{{ 'mango_t.webp' | asset_url }}" alt="" loading="lazy" ></div></div>
        <div class="fruit back shop-d-8" data-px="-0.07" ><div class="fb"><img class="shop-d-9" src="{{ 'pineapple_t.webp' | asset_url }}" alt="" loading="lazy" ></div></div>
      </div>
      <div class="abs pdp-shadow"></div>
      <div class="pdp-can" id="pdpCan"><div class="pdp-can-in">
        <canvas class="pc spin-cv" id="pdpCv" role="img" aria-label="Cherry Limeade can"></canvas>
        <img class="pc c-cherry" src="{{ 'pdp_can.webp' | asset_url }}" alt="Cherry Limeade can" loading="lazy">
        <img class="pc c-pine" src="{{ 'card2_can.webp' | asset_url }}" alt="Pineapple Mango can" loading="lazy">
      </div></div>
      <ul class="feat">
        <li><svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M4.5 0v9M0 4.5h9" stroke="#302952" stroke-width="1"/></svg>200 MG Caffeine</li><li><svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M4.5 0v9M0 4.5h9" stroke="#302952" stroke-width="1"/></svg>Zero Sugar</li><li><svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M4.5 0v9M0 4.5h9" stroke="#302952" stroke-width="1"/></svg>Zero 🍃</li><li><svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M4.5 0v9M0 4.5h9" stroke="#302952" stroke-width="1"/></svg>15 Calories</li><li><svg width="9" height="9" viewBox="0 0 9 9" aria-hidden="true"><path d="M4.5 0v9M0 4.5h9" stroke="#302952" stroke-width="1"/></svg>Gluten Free</li>
      </ul>
    </div>

    <button type="button" class="thumb fx-rise shop-d-10" data-fx="cards" data-thumb="0"  aria-label="View 1"><img src="{{ 'thumb1.webp' | asset_url }}" alt="" loading="lazy"></button>
    <button type="button" class="thumb fx-rise shop-d-11" data-fx="cards" data-thumb="1"  aria-label="View 2"><img src="{{ 'thumb2.webp' | asset_url }}" alt="" loading="lazy"></button>
    <button type="button" class="thumb fx-rise shop-d-12" data-fx="cards" data-thumb="2"  aria-label="View 3"><img src="{{ 'thumb3.webp' | asset_url }}" alt="" loading="lazy"></button>
    <div class="thumb-ring fx-fade shop-d-13" data-fx="cards" id="thumbRing" ></div>

    <div class="eb fx-rise shop-d-14" data-fx="reveal" >Shop</div>
    <h2 class="abs h45 fx-rise shop-d-15" data-fx="reveal" ><span class="ttl-swap" id="pdpTitle"><span>Cherry Limeade Energy Drink</span><span class="out" aria-hidden="true">Pineapple Mango Energy Drink</span></span></h2>
    <div class="abs stars fx-rise shop-d-16" data-fx="reveal" >
      <svg width="141" height="25" viewBox="0 0 141 25" aria-label="5 out of 5 stars"><g fill="#DE9100"><polygon points="12.50,0.40 15.67,8.53 24.39,9.04 17.64,14.57 19.85,23.01 12.50,18.30 5.15,23.01 7.36,14.57 0.61,9.04 9.33,8.53" stroke="#DE9100" stroke-width="1.6" stroke-linejoin="round"/><polygon points="41.50,0.40 44.67,8.53 53.39,9.04 46.64,14.57 48.85,23.01 41.50,18.30 34.15,23.01 36.36,14.57 29.61,9.04 38.33,8.53" stroke="#DE9100" stroke-width="1.6" stroke-linejoin="round"/><polygon points="70.50,0.40 73.67,8.53 82.39,9.04 75.64,14.57 77.85,23.01 70.50,18.30 63.15,23.01 65.36,14.57 58.61,9.04 67.33,8.53" stroke="#DE9100" stroke-width="1.6" stroke-linejoin="round"/><polygon points="99.50,0.40 102.67,8.53 111.39,9.04 104.64,14.57 106.85,23.01 99.50,18.30 92.15,23.01 94.36,14.57 87.61,9.04 96.33,8.53" stroke="#DE9100" stroke-width="1.6" stroke-linejoin="round"/><polygon points="128.50,0.40 131.67,8.53 140.39,9.04 133.64,14.57 135.85,23.01 128.50,18.30 121.15,23.01 123.36,14.57 116.61,9.04 125.33,8.53" stroke="#DE9100" stroke-width="1.6" stroke-linejoin="round"/></g></svg><span>(120)</span>
    </div>
    <div class="abs p22 fx-rise shop-d-17" data-fx="reveal" >$24.99</div>
    <p class="abs b18 fx-rise shop-d-18" data-fx="reveal" >Speaking to flavor notes, lorem ipsum dolor sit amet, consectetur adipiscing elit, dolor sit. Pellentesque sit amet sapien fringilla, mattis ligula consectetur.</p>

    <div class="abs m14 fx-rise shop-d-19" data-fx="reveal" >Select Flavor:</div>
    <button type="button" class="ftile fx-rise shop-d-20" data-fx="reveal" data-pick="cherry"  aria-label="Cherry Limeade"><img class="shop-d-21" src="{{ 'tile_cherry.webp' | asset_url }}" alt="" loading="lazy" ></button>
    <button type="button" class="ftile fx-rise shop-d-22" data-fx="reveal" data-pick="pine"  aria-label="Pineapple Mango"><img class="shop-d-23" src="{{ 'tile_pm_can.webp' | asset_url }}" alt="" loading="lazy" ></button>
    <div class="ftile-ring fx-fade shop-d-24" data-fx="reveal" id="tileRing" ></div>
    <div class="abs flbl fx-rise shop-d-25" data-fx="reveal" data-flbl="cherry" >Cherry Limeade</div>
    <div class="abs flbl dim fx-rise shop-d-26" data-fx="reveal" data-flbl="pine" >Pineapple Mango</div>

    <div class="abs m14 fx-rise shop-d-27" data-fx="reveal" >Select Size:</div>
    <div class="abs sizes fx-rise shop-d-28" data-fx="reveal"  role="group" aria-label="Pack size">
      <button type="button" class="size" aria-pressed="false">4-Pack</button>
      <button type="button" class="size" aria-pressed="true">12-Pack</button>
      <button type="button" class="size" aria-pressed="false">24-Pack</button>
    </div>
    <button type="button" class="abs qbtn fx-rise shop-d-29" data-fx="reveal" data-q="-1"  aria-label="Decrease quantity">-</button>
    <div class="abs qty fx-rise shop-d-30" data-fx="reveal" id="qty"  aria-live="polite">1</div>
    <button type="button" class="abs qbtn fx-rise shop-d-31" data-fx="reveal" data-q="1"  aria-label="Increase quantity">+</button>
    <button type="button" class="atc fx-rise shop-d-32" data-fx="reveal" id="atc" ><span class="lbl">Add to Cart</span><span class="done">Added to cart ✓</span></button>

    <div class="abs vl fx-fade shop-d-33" data-fx="reveal" ></div>
    <button type="button" class="opt fx-rise shop-d-34" data-fx="reveal" role="radio" aria-checked="true" data-opt="once" >
      <span class="radio"></span><span class="ol">One-Time Purchase</span><span class="op">$24.99</span>
    </button>
    <button type="button" class="opt fx-rise shop-d-35" data-fx="reveal" role="radio" aria-checked="false" data-opt="auto" >
      <span class="radio shop-d-36" ></span><span class="ol shop-d-37" >Auto-ship (save 20%)</span><span class="op green shop-d-37" >$24.99</span>
      <ul><li><svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="8.5" fill="#C3DF80"/><path d="M5.6 8.7l2 2 3.8-4" fill="none" stroke="#302C4B" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>Save 20% and get free shipping over $50</li><li><svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="8.5" fill="#C3DF80"/><path d="M5.6 8.7l2 2 3.8-4" fill="none" stroke="#302C4B" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>Automatic deliveries</li><li><svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="8.5" fill="#C3DF80"/><path d="M5.6 8.7l2 2 3.8-4" fill="none" stroke="#302C4B" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>Pause, swap, or cancel anytime</li></ul>
    </button>
  </section>

    </div>
  </div>
</div>

