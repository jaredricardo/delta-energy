      <div class="mstars fx-rise shop-m-13" data-fx="reveal" ><svg viewBox="0 0 116 20" aria-label="5 out of 5 stars"><g fill="#DE9100"><polygon points="10.00,3.10 11.79,8.13 17.13,8.28 12.90,11.54 14.41,16.67 10.00,13.65 5.59,16.67 7.10,11.54 2.87,8.28 8.21,8.13" stroke="#DE9100" stroke-width=".9" stroke-linejoin="round"/><polygon points="34.00,3.10 35.79,8.13 41.13,8.28 36.90,11.54 38.41,16.67 34.00,13.65 29.59,16.67 31.10,11.54 26.87,8.28 32.21,8.13" stroke="#DE9100" stroke-width=".9" stroke-linejoin="round"/><polygon points="58.00,3.10 59.79,8.13 65.13,8.28 60.90,11.54 62.41,16.67 58.00,13.65 53.59,16.67 55.10,11.54 50.87,8.28 56.21,8.13" stroke="#DE9100" stroke-width=".9" stroke-linejoin="round"/><polygon points="82.00,3.10 83.79,8.13 89.13,8.28 84.90,11.54 86.41,16.67 82.00,13.65 77.59,16.67 79.10,11.54 74.87,8.28 80.21,8.13" stroke="#DE9100" stroke-width=".9" stroke-linejoin="round"/><polygon points="106.00,3.10 107.79,8.13 113.13,8.28 108.90,11.54 110.41,16.67 106.00,13.65 101.59,16.67 103.10,11.54 98.87,8.28 104.21,8.13" stroke="#DE9100" stroke-width=".9" stroke-linejoin="round"/></g></svg><span>(120)</span></div>
